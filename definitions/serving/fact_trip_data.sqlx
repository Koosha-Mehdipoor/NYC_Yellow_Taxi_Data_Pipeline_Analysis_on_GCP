config {
    type: "table",
    database: "trip-record-data",
    schema: "serving_layer",
    name: "fact_trip_data",

}
SELECT 
trip_id,
VendorID,
pickup_date,
dropoff_date,
pickup_hour,
pickup_minute,
droppoff_hour,
droppoff_minute,
passenger_count,
trip_distance,
RatecodeID,
rate_type,
store_and_fwd_flag,
PULocationID,
DOLocationID,
payment_type,
fare_amount,
extra,
mta_tax	,
tip_amount,
tolls_amount,
improvement_surcharge,
total_amount,
congestion_surcharge,
Airport_fee,
cbd_congestion_fee	
FROM ${ref("V_STG_trip_data")} 