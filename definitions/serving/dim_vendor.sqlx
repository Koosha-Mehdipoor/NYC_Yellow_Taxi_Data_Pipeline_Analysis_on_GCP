
-- this dimension is not necessary in this case and can be considered in the fact table but in general this approach can be usefull if there are some changes in the future
config {
    type: "table",
    database: "trip-record-data",
    schema: "serving_layer",
    name: "dim_vendor",

}


SELECT
DISTINCT
  VendorID,
  vendor_name
FROM
  ${ref("V_STG_trip_data")}
