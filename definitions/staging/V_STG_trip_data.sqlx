config {
    type: "view",
    database: "trip-record-data",
    schema: "load_staging_layer",
    name: "V_STG_trip_data",
}

SELECT
trip_id AS trip_id,
VendorID AS VendorID,
vendor_name AS vendor_name,
DATE(tpep_pickup_datetime) AS pickup_date,
DATE(tpep_dropoff_datetime) AS dropoff_date,
EXTRACT(HOUR FROM tpep_pickup_datetime) AS pickup_hour,
EXTRACT(MINUTE FROM tpep_pickup_datetime) AS pickup_minute,
EXTRACT(HOUR FROM tpep_dropoff_datetime) AS droppoff_hour,
EXTRACT(MINUTE FROM tpep_dropoff_datetime) AS droppoff_minute,
passenger_count AS passenger_count,
trip_distance AS trip_distance,
RatecodeID AS RatecodeID,
rate_type,
store_and_fwd_flag,
PULocationID,
DOLocationID,
payment_type,
paymenttype_name,
fare_amount,
extra,
mta_tax	,
tip_amount,
tolls_amount,
improvement_surcharge,
total_amount,
congestion_surcharge,
Airport_fee,
cbd_congestion_fee	,
file_ingestion_time,
INSERTION_DATE
FROM ${ref("STG_trip_data")} 