config {
    type: "view",
    database: "trip-record-data",
    schema: "load_staging_layer",
    name: "V_taxi_zones"

}

SELECT 
LocationID,
z.Borough AS Borough,
Zone,
service_zone,
zone_geom,
CURRENT_TIMESTAMP AS file_ingestion_time
FROM 
  ${ref("taxi_zones")} z
LEFT JOIN ${ref("taxi_zones_gecode")} geo
ON z.LocationID = geo.zone_id

