config {
    type: "incremental",
    uniqueKey: ["trip_id"],
    bigquery: {
    partitionBy: "DATE(tpep_pickup_datetime)",
  },

    database: "trip-record-data",
    schema: "load_staging_layer",
    name: "STG_trip_data",
}

SELECT
  * EXCEPT(row_num),
  
  CURRENT_TIMESTAMP() AS INSERTION_DATE
FROM
  ${ref("V_yellow_tripdata")}
